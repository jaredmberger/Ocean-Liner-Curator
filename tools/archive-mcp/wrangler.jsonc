{
  "name": "ocean-liner-archive-mcp",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "services": [
    {
      "binding": "ARCHIVE",
      "service": "ocean-liner-curator-git"
    }
  ],
  "observability": {
    "enabled": false
  }
}
